<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cx_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- BAŞLIK (logo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cx_logo_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/cx_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PS5 → Telefon → Philips TV · GTA 6 sokak dili"
                android:textColor="@color/cx_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- DAHİLİ REMOTE PLAY -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CxKart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="@color/cx_pink"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CxKartBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 PS5'i Çevirix içinde aç (önerilen)" />

                <TextView
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PS Remote Play uygulamasına gerek yok. Oyun görüntüsü Çevirix'in içinde açılır, altyazı doğrudan oradan okunur ve TV'ye gönderilir." />

                <TextView
                    android:id="@+id/psnStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/cx_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/psnLoginBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1) PlayStation hesabıyla giriş yap"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ps5Btn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:text="2) PS5'e bağlan ve oyna"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/streamTranslateSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Oyun açıkken altyazıyı çevir"
                    android:textColor="@color/cx_text" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/backgroundSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arka planda devam et (telefonu kullanabilirsin)"
                    android:textColor="@color/cx_text" />

                <TextView
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="İlk seferde: PS5'te Ayarlar › Sistem › Uzaktan Oynama › Cihazı Eşleştir deyin, ekrandaki 8 haneli kodu Çevirix'teki eşleştirme ekranına yazın." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DURUM -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CxKart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/cx_dot" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/cx_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="0dp">

                    <TextView
                        android:id="@+id/tvChip"
                        style="@style/CxEtiket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/ipChip"
                        style="@style/CxEtiket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/latencyChip"
                        style="@style/CxEtiket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/lastTr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/cx_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lastEn"
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startBtn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:text="Ekran okuma modunu başlat"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/cx_ic_stat"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openRpBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="PS Remote Play'e geç"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="TV'ye test altyazısı gönder"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ÇEVİRİ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CxKart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CxKartBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Çeviri motoru" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/geminiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gemini ile sokak dili (önerilir)"
                    android:textColor="@color/cx_text" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/instantSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Anında çeviri (önce hızlı, sonra sokak dili)"
                    android:textColor="@color/cx_text" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keyLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Gemini API anahtarı"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Model" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/modelChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFast"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="gemini-3.5-flash-lite"
                        android:text="3.5 Flash-Lite · en hızlı" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSmart"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="gemini-3.6-flash"
                        android:text="3.6 Flash · en kaliteli" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBackup"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="gemini-2.5-flash-lite"
                        android:text="2.5 Flash-Lite · yedek" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Model adı (elle de yazılabilir)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/modelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testKeyBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Anahtarı test et" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getKeyBtn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ücretsiz anahtar al" />
                </LinearLayout>

                <TextView
                    android:id="@+id/keyResult"
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/offlineText"
                        style="@style/CxAciklama"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/offlineBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İndir" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DUBLAJ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CxKart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CxKartBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Canlı Türkçe dublaj" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dubSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Çeviriyi sesli oku"
                    android:textColor="@color/cx_text" />

                <TextView
                    android:id="@+id/rateLabel"
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/rateSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="70"
                    android:valueTo="160" />

                <TextView
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ses kanalı" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/voiceToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoiceNotif"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bildirim sesi" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoiceMedia"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Medya sesi" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="İpucu: &quot;Bildirim sesi&quot; seçiliyken telefonun medya sesini sıfırlayın. Böylece Remote Play'in oyun sesi susar, sadece Türkçe dublaj duyulur." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ALTYAZI BÖLGESİ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CxKart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CxKartBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Altyazı okuma bölgesi" />

                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/cx_preview_bg"
                    android:contentDescription="Altyazı bölgesi önizlemesi"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/rawText"
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/cx_cyan" />

                <TextView
                    android:id="@+id/roiLabel"
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/roiSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="30"
                    android:valueTo="100" />

                <TextView
                    style="@style/CxAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Önizleme, Remote Play açıkken okunan şeridi gösterir. Altyazı yazısı kutunun içinde kalacak şekilde ayarlayın." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TV GÖRÜNÜMÜ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CxKart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/CxKartBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV'deki altyazı görünümü" />

                <TextView
                    android:id="@+id/fontLabel"
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/fontSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="2"
                    android:valueFrom="18"
                    android:valueTo="48" />

                <TextView
                    android:id="@+id/yLabel"
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/ySlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="10"
                    android:valueTo="250" />

                <TextView
                    android:id="@+id/alphaLabel"
                    style="@style/CxAciklama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/alphaSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="255" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/enSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Altında küçük İngilizce satırı da göster"
                    android:textColor="@color/cx_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvPreviewBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="TV'de örnek göster" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/CxAciklama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Telefon ve TV aynı Wi-Fi ağında olmalı. TV uygulaması telefonu kendiliğinden bulur." />
    </LinearLayout>
</ScrollView>
